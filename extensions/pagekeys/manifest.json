{
  "manifest_version": 3,
  "name": "pagekeys",
  "version": "0.1.0",
  "description": "Scroll with j/k/d/u/gg/G and follow links by hints with f/F.",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["pagekeys.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
