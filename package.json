{
  "name": "domicile-svelte-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "shell"
  ],
  "scripts": {
    "build": "bun run --cwd shell build",
    "check": "prettier --check . && bun run --filter '*' check",
    "format": "prettier --write .",
    "test": "bun test"
  },
  "devDependencies": {
    "@cprussin/option-result": "^2.0.1",
    "@domicile-desktop/sdk": "file:.fork-sdk/sdk.tgz",
    "@domicile-desktop/system-audio": "1.1.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/bun": "^1.3.0",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "4.2.0",
    "svelte": "^5.59.1",
    "svelte-check": "^4.3.0",
    "typescript": "~6",
    "vite": "^8.3.8"
  },
  "overrides": {
    "@domicile-desktop/sdk": "file:.fork-sdk/sdk.tgz"
  }
}
